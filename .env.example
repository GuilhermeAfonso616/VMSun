# Banco recomendado para producao/staging.
# Para desenvolvimento local sem PostgreSQL, use: sqlite:///D:/Analitico/data/analytics.db
DATABASE_URL=postgresql+psycopg://analitico:analitico@localhost:5433/analitico
API_AUTH_REQUIRED=true
# auto gera uma chave unica e persistente em runtime_state/auth_secret_key.
AUTH_SECRET_KEY=auto
# auto gera uma chave separada para cifrar credenciais de cameras no banco.
CREDENTIAL_ENCRYPTION_KEY=auto
SESSION_TTL_SECONDS=604800
# Vazio/ausente ativa Secure automaticamente em HTTPS; force true atras de TLS.
# SESSION_COOKIE_SECURE=true
PASSWORD_MIN_LENGTH=12
NOTIFICATION_DISPATCH_ENABLED=true
NOTIFICATION_POLL_SECONDS=5
NOTIFICATION_RETRY_BASE_SECONDS=30
NOTIFICATION_DELIVERY_RETENTION_DAYS=90
INCIDENT_SLA_CRITICAL_MINUTES=5
INCIDENT_SLA_HIGH_MINUTES=15
INCIDENT_SLA_MEDIUM_MINUTES=60
INCIDENT_SLA_LOW_MINUTES=240
INCIDENT_SLA_MONITOR_SECONDS=15
CAMERA_BULK_DELETE_PASSWORD=EXCLUIR_TODAS
DOCKER_STACK_CONTROL_ENABLED=false
DOCKER_STACK_CONTROL_PASSWORD=
APP_ROLE=all
RUNTIME_API_BASE_URL=
RUNTIME_API_TIMEOUT_SECONDS=3
RUNTIME_INTERNAL_PORT=8001
SUPERVISOR_API_TOKEN=
DETECTOR_MODEL_PATH=C:/Users/mvpro/Music/IA/runs/detect/crowdhuman_person_80ep_fbox/weights/best.pt
DETECT_CONF=0.05
DETECT_IMGSZ=640
DETECT_DEVICE=auto
TRACKER_CONFIG=bytetrack.yaml
RTSP_TRANSPORT=udp
RTSP_OPEN_TIMEOUT_MS=12000
RTSP_READ_TIMEOUT_MS=12000
RECONNECT_SECONDS=8
TRACK_EXIT_TIMEOUT_SECONDS=2.0
INTRUSION_MIN_INSIDE_FRAMES=3
INTRUSION_MIN_OUTSIDE_FRAMES=5
INTRUSION_LOST_TRACK_TIMEOUT_SECONDS=1.5
INTRUSION_MIN_TRACK_AGE_FRAMES=3
INTRUSION_MIN_CONFIDENCE=0.05
INTRUSION_MIN_BBOX_AREA=1200
CAMERA_HEALTH_CHECK_INTERVAL_SECONDS=15
CAMERA_HEALTH_OFFLINE_AFTER_SECONDS=45
CAMERA_HEALTH_STARTUP_GRACE_SECONDS=75
CAMERA_HEALTH_RECONNECT_GRACE_SECONDS=45
CAMERA_HEALTH_RESTORE_WORKERS_ON_STARTUP=true
CAMERA_GATEWAY_ENABLED=true
CAMERA_GATEWAY_BASE_URL=http://camera-gateway:8090
CAMERA_GATEWAY_WORKER_RTSP_FALLBACK_ENABLED=false
CAMERA_GATEWAY_CIRCUIT_PARK_AFTER_SECONDS=120
GATEWAY_OUTPUT_FPS=2
GATEWAY_JPEG_QUALITY=12
GATEWAY_FFMPEG_LATENCY_PROFILE=compatibility
GATEWAY_FFMPEG_BALANCED_CAMERA_IDS=
GATEWAY_FFMPEG_LOW_LATENCY_CAMERA_IDS=
GATEWAY_FFMPEG_PROFILE_FALLBACK_ENABLED=true
GATEWAY_FFMPEG_PROFILE_STRICT=false
GATEWAY_MAX_ANALYTIC_FRAME_AGE_MS=0
GATEWAY_MAX_ANALYTIC_FRAME_AGE_CAMERA_IDS=
GATEWAY_FRAME_LAG_WATCHDOG_ENABLED=false
GATEWAY_FRAME_LAG_WATCHDOG_CAMERA_IDS=
GATEWAY_FRAME_LAG_RESTART_THRESHOLD_MS=2000
GATEWAY_FRAME_LAG_RESTART_HOLD_SECONDS=5
GATEWAY_FRAME_LAG_RESTART_COOLDOWN_SECONDS=30
GATEWAY_FRAME_LAG_RESTART_MAX_PER_HOUR=3
GATEWAY_FFMPEG_HWACCEL_ENABLED=false
GATEWAY_FFMPEG_HWACCEL_FALLBACK_ENABLED=true
GATEWAY_FFMPEG_HWACCEL=cuda
GATEWAY_FFMPEG_HWACCEL_OUTPUT_FORMAT=cuda
GATEWAY_FFMPEG_VIDEO_DECODER=
GATEWAY_FFMPEG_GPU_SCALE_ENABLED=true
GATEWAY_FFMPEG_GPU_SCALE_WIDTH=960
GATEWAY_FFMPEG_GPU_SCALE_HEIGHT=540
WEBRTC_GATEWAY_ENABLED=true
WEBRTC_GATEWAY_API_BASE_URL=http://webrtc-gateway:9997
# Base HTTPS publica entregue ao navegador, sem / final nem :8889.
# Exemplo: https://video.sunorus.com.br
WEBRTC_GATEWAY_PUBLIC_BASE_URL=
WEBRTC_GATEWAY_RTSP_BASE_URL=rtsp://webrtc-gateway:8554
WEBRTC_GATEWAY_RTSP_PUBLIC_BASE_URL=
WEBRTC_GATEWAY_MONITOR_ENABLED=true
CAMERA_GATEWAY_SOURCE_MODE=mediamtx_prefer
CAMERA_GATEWAY_MEDIAMTX_CAMERA_IDS=
FRAME_TRANSPORT_MODE=http
FRAME_TRANSPORT_CAMERA_IDS=
FRAME_TRANSPORT_PROTOCOL_VERSION=1
FRAME_TRANSPORT_ROOT=/run/sunorus/frames
FRAME_TRANSPORT_SLOT_COUNT=4
FRAME_TRANSPORT_SLOT_CAPACITY_BYTES=2097152
FRAME_TRANSPORT_POLL_INTERVAL_MS=5
FRAME_TRANSPORT_READ_TIMEOUT_MS=1000
FRAME_TRANSPORT_REMOVE_ON_STOP=false
FRAME_TRANSPORT_FALLBACK_ENABLED=true
INFERENCE_TRANSPORT_MODE=http
INFERENCE_TRANSPORT_CAMERA_IDS=
INFERENCE_TRANSPORT_SOCKET_PATH=/run/sunorus/inference.sock
INFERENCE_TRANSPORT_TIMEOUT_MS=5000
MEDIA_BACKBONE_RECONCILE_ENABLED=true
MEDIA_BACKBONE_RECONCILE_INTERVAL_SECONDS=30
MEDIA_BACKBONE_REMOVE_ORPHAN_PATHS=true
GATEWAY_SOURCE_POLICY=any
GATEWAY_ALLOWED_RTSP_HOSTS=webrtc-gateway
GATEWAY_BACKBONE_RECONNECT_DELAY_SECONDS=1
GATEWAY_BACKBONE_RECONNECT_BACKOFF_MAX_SECONDS=5
WEBRTC_GATEWAY_RTSP_BIND_ADDRESS=0.0.0.0
CAMERA_HEALTH_PROBE_TIMEOUT_SECONDS=2.5
SAVE_EVENT_SNAPSHOTS=true
EVENT_SNAPSHOTS_DIR=event_snapshots

# Instaladores do SunOrus Video Helper oferecidos no mosaico quando o navegador
# nao decodifica HEVC.
VIDEO_HELPER_DIST_DIR=data/downloads/video-helper
EVENT_CLIP_BEFORE_SECONDS=5.0
EVENT_CLIP_AFTER_SECONDS=10.0
EVENT_CLIP_HISTORY_SECONDS=18.0
EVENT_CLIP_VIDEO_ENABLED=true
EVENT_CLIP_VIDEO_FPS=2.0
LOCAL_CLIP_RETENTION_MAX_TOTAL=100
LOCAL_CLIP_RETENTION_MAX_FALSE_POSITIVE=50
ONEDRIVE_CLIP_ARCHIVE_ENABLED=false
ONEDRIVE_TENANT=organizations
ONEDRIVE_CLIENT_ID=
ONEDRIVE_TOKEN_FILE=runtime_state/onedrive_token.json
ONEDRIVE_AUDIT_PREFIX=audit_pending
VISUAL_MOTION_DEBUG_OVERLAY_ENABLED=false
MONITOR_MOTION_BOXES_ENABLED=false
VISUAL_RAW_PUBLISH_ENABLED=false
VISUAL_PROCESSED_PUBLISH_ENABLED=true
VISUAL_RAW_PUBLISH_INTERVAL_SECONDS=0.25
VISUAL_PROCESSED_PUBLISH_INTERVAL_SECONDS=0.50
VISUAL_MAX_RESULT_AGE_SECONDS=1.0
LOCKDOWN_INGEST_ENABLED=true
LOCKDOWN_INGEST_URL=https://lockdown-security.com/api/events/ingest
LOCKDOWN_INGEST_SECRET=
LOCKDOWN_INGEST_TIMEOUT_SECONDS=5.0

# Revalidadores recomendados em 2026-05-11.
PERSON_REVALIDATOR_MODEL_PATH=models/revalidator/person_crop_revalidator_yolo11n_v5.pt
PERSON_REVALIDATOR_MODE=block
PERSON_REVALIDATOR_THRESHOLD=0.50
FAR_PERSON_REVALIDATOR_MODEL_PATH=models/revalidator_far/person_far_revalidator_yolo11n_v1.pt
FAR_PERSON_REVALIDATOR_THRESHOLD=0.48
REVALIDATOR_POOL_ENABLED=false
REVALIDATOR_POOL_DEVICE=auto
REVALIDATOR_POOL_MAX_CONCURRENCY=1
REVALIDATOR_POOL_MAX_QUEUE_SIZE=32
REVALIDATOR_POOL_JOB_TIMEOUT_SECONDS=3.0
REVALIDATOR_POOL_MAX_JOB_AGE_SECONDS=10.0
IA2_V8B_SHADOW_ENABLED=false
IA2_V8B_SHADOW_MODEL_PATH=models/revalidator/person_crop_revalidator_yolo11n_v8b_ultra_conservative.pt
IA2_V8B_SHADOW_THRESHOLD=0.15
IA2_V8C_SHADOW_ENABLED=false
IA2_V8C_SHADOW_MODEL_PATH=models/revalidator/person_crop_revalidator_yolo11n_v8c_curated_safe.pt
IA2_V8C_SHADOW_THRESHOLD=0.20
IA3_V2_PROTECTION_ENABLED=false
IA3_V2_PROTECTION_MODEL_PATH=models/revalidator_far/person_far_revalidator_yolo11n_v2.pt
IA3_V2_PROTECTION_THRESHOLD=0.94

# Motion Confirmation Settings
MOTION_CONFIRM_ENABLED=true
MOTION_CONFIRM_MODE=audit
# Movimento claro apenas reforca a evidencia; ausencia de movimento nao bloqueia evento.
EVENT_MATURITY_VISUAL_PERSON_THRESHOLD=0.50
EVENT_MATURITY_VISUAL_FAR_PERSON_THRESHOLD=0.10
MOTION_CONFIRM_MIN_BLOBS=2
MOTION_CONFIRM_MIN_AREA_PCT=0.05
MOTION_CONFIRM_MIN_DISPLACEMENT=0.03
MOTION_CONFIRM_BOOST_MIN_BLOBS=5
MOTION_CONFIRM_BOOST_MIN_AREA_PCT=0.50
MOTION_CONFIRM_BLOB_MIN_AREA_PX=2
MOTION_CONFIRM_HISTORY_SIZE=20
MOTION_CONFIRM_THRESHOLD_PX=15

# --- Etapa 3: execucao centralizada das inferencias auxiliares (IA2/IA3) ---
# Modos: local | central_prefer | central_strict. Nada e ativado por padrao.
IA2_EXECUTION_MODE=local
IA2_CENTRAL_CAMERA_IDS=
IA2_POOL_ENABLED=false
IA2_POOL_WORKER_COUNT=1
IA2_POOL_MAX_QUEUE_SIZE=64
IA2_POOL_TIMEOUT_MS=1500
IA2_POOL_MAX_CONCURRENCY=1
IA2_POOL_PRIORITY_ENABLED=true

IA3_EXECUTION_MODE=local
IA3_CENTRAL_CAMERA_IDS=
IA3_POOL_ENABLED=false
IA3_POOL_WORKER_COUNT=1
IA3_POOL_MAX_QUEUE_SIZE=32
IA3_POOL_TIMEOUT_MS=2000
IA3_POOL_MAX_CONCURRENCY=1
IA3_POOL_PRIORITY_ENABLED=true

SHADOW_EXECUTION_MODE=local
SHADOW_CENTRAL_CAMERA_IDS=
SHADOW_POOL_ENABLED=false
SHADOW_POOL_MAX_QUEUE_SIZE=16

AUX_INFERENCE_TRANSPORT_MODE=http
AUX_INFERENCE_SOCKET_PATH=/run/sunorus/aux-inference.sock
AUX_INFERENCE_TIMEOUT_MS=3000

# Canal binario proprio da IA2 (separado do socket da IA1).
IA2_TRANSPORT_MODE=http
IA2_TRANSPORT_SOCKET_PATH=/run/sunorus/ia2.sock
IA2_TRANSPORT_TIMEOUT_MS=1500
