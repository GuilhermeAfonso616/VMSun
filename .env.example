# Configuração Recomendada do VMSun
PRODUCT_MODE=vms

# Banco de Dados PostgreSQL para VMSun (Porta 5435 para não conflitar com o Orus em 5433)
DATABASE_URL=postgresql+psycopg://vmsun:vmsun@localhost:5435/vmsun
POSTGRES_PORT=5435

# Portas da Aplicação VMSun (Web em 8100, Control em 8101, Gateway em 8190)
APP_HOST=0.0.0.0
APP_PORT=8100
RUNTIME_INTERNAL_PORT=8101
CAMERA_GATEWAY_PORT=8190

API_AUTH_REQUIRED=true
AUTH_SECRET_KEY=auto
CREDENTIAL_ENCRYPTION_KEY=auto
SESSION_TTL_SECONDS=604800
PASSWORD_MIN_LENGTH=12

APP_ROLE=all
CAMERA_BULK_DELETE_PASSWORD=EXCLUIR_TODAS

# Câmera Gateway (Go)
CAMERA_GATEWAY_ENABLED=true
CAMERA_GATEWAY_BASE_URL=http://vmsun-camera-gateway:8090
CAMERA_GATEWAY_WORKER_RTSP_FALLBACK_ENABLED=false
CAMERA_GATEWAY_CIRCUIT_PARK_AFTER_SECONDS=120
GATEWAY_OUTPUT_FPS=2
GATEWAY_JPEG_QUALITY=12

# MediaMTX & WebRTC Backbone (RTSP em 8654, WebRTC em 8989, UDP em 8289)
WEBRTC_GATEWAY_ENABLED=true
WEBRTC_GATEWAY_API_BASE_URL=http://vmsun-mediamtx:9997
WEBRTC_GATEWAY_PUBLIC_BASE_URL=
WEBRTC_GATEWAY_RTSP_BASE_URL=rtsp://vmsun-mediamtx:8554
WEBRTC_GATEWAY_RTSP_PUBLIC_BASE_URL=
WEBRTC_GATEWAY_MONITOR_ENABLED=true
MEDIA_BACKBONE_RECONCILE_ENABLED=true
MEDIA_BACKBONE_RECONCILE_INTERVAL_SECONDS=30
MEDIA_BACKBONE_REMOVE_ORPHAN_PATHS=true

# Monitoramento de Saúde das Câmeras
CAMERA_HEALTH_CHECK_INTERVAL_SECONDS=15
CAMERA_HEALTH_OFFLINE_AFTER_SECONDS=45
CAMERA_HEALTH_STARTUP_GRACE_SECONDS=75
