<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- net48 em vez de net8: o .NET Framework 4.8 ja acompanha o Windows 10/11,
         entao o setup nao precisa carregar um runtime dentro de si. So isso tira
         ~11,5 MB do executavel, e o codigo daqui usa apenas MessageBoxW,
         HttpClient, ZipFile, Registry e Process - tudo presente no 4.8. -->
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <!-- WinForms nao sobrevive ao trimming (depende de reflexao). As poucas caixas
         de dialogo daqui usam MessageBoxW direto do user32. -->
    <UseWindowsForms>false</UseWindowsForms>
    <ImplicitUsings>false</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- Sem isso o build gera um .exe.config so com <supportedRuntime>, e o setup
         deixaria de ser um arquivo unico para distribuir. -->
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AssemblyName>SunOrus.Video.Helper.Setup</AssemblyName>
    <ApplicationIcon>..\..\src\Analitico.Operator.App\Assets\sunorus-logo.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <!-- URL do FFmpeg usada quando o payload nao traz o binario. Pode ser trocada
         no build: dotnet publish -p:FfmpegDownloadUrl=https://... -->
    <FfmpegDownloadUrl Condition="'$(FfmpegDownloadUrl)' == ''">https://www.gyan.dev/ffmpeg/builds/ffmpeg-release-essentials.zip</FfmpegDownloadUrl>
    <!-- Preenchidos por build_video_helper_installer.ps1 no modo enxuto: onde o
         zip do helper foi publicado e o hash que ele deve ter. -->
    <PayloadDownloadUrl Condition="'$(PayloadDownloadUrl)' == ''"></PayloadDownloadUrl>
    <PayloadSha256 Condition="'$(PayloadSha256)' == ''"></PayloadSha256>
    <EmbutirPayload Condition="'$(EmbutirPayload)' == ''">false</EmbutirPayload>
  </PropertyGroup>

  <ItemGroup>
    <!-- Permite compilar net48 sem Visual Studio instalado (o SDK do .NET nao traz
         os reference assemblies do .NET Framework). -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="FfmpegDownloadUrl" Value="$(FfmpegDownloadUrl)" />
    <AssemblyMetadata Include="PayloadDownloadUrl" Value="$(PayloadDownloadUrl)" Condition="'$(PayloadDownloadUrl)' != ''" />
    <AssemblyMetadata Include="PayloadSha256" Value="$(PayloadSha256)" Condition="'$(PayloadSha256)' != ''" />
  </ItemGroup>

  <!-- Modo offline: o zip volta para dentro do executavel. -->
  <ItemGroup Condition="'$(EmbutirPayload)' == 'true'">
    <EmbeddedResource Include="Payload\SunOrusVideoHelperPayload.zip"
                      LogicalName="SunOrusVideoHelperPayload.zip" />
  </ItemGroup>

  <Target Name="ValidarOrigemDoPayload" BeforeTargets="BeforeBuild">
    <Error Condition="'$(EmbutirPayload)' == 'true' AND !Exists('Payload\SunOrusVideoHelperPayload.zip')"
           Text="Payload nao encontrado para o modo offline. Rode build_video_helper_installer.ps1 -EmbutirPayload." />
    <Error Condition="'$(EmbutirPayload)' != 'true' AND '$(PayloadDownloadUrl)' == ''"
           Text="Sem payload embutido e sem PayloadDownloadUrl: o setup gerado nao teria como instalar o helper. Rode build_video_helper_installer.ps1 -PayloadUrl https://... (ou -EmbutirPayload)." />
  </Target>
</Project>
