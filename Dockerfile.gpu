# syntax=docker/dockerfile:1
FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_ROOT_USER_ACTION=ignore \
    TZ=America/Sao_Paulo

WORKDIR /app

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-dev \
    python3-venv \
    python-is-python3 \
    tzdata \
    ffmpeg \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libgomp1

RUN ln -sf /usr/bin/python3 /usr/bin/python

ARG PYTORCH_INDEX_URL=https://download.pytorch.org/whl/cu124
ARG TORCH_VERSION=2.6.0
ARG TORCHVISION_VERSION=0.21.0

RUN --mount=type=cache,id=analitico-gpu-pip-cache,target=/root/.cache/pip,sharing=locked \
    python -m pip install --upgrade pip && \
    python -m pip install \
        torch==${TORCH_VERSION} \
        torchvision==${TORCHVISION_VERSION} \
        --index-url ${PYTORCH_INDEX_URL}

COPY requirements-gpu.txt /app/requirements-gpu.txt

RUN --mount=type=cache,id=analitico-gpu-pip-cache,target=/root/.cache/pip,sharing=locked \
    python -m pip install --extra-index-url https://pypi.nvidia.com -r /app/requirements-gpu.txt

RUN --mount=type=cache,id=analitico-gpu-pip-cache,target=/root/.cache/pip,sharing=locked \
    python -m pip install --extra-index-url https://pypi.nvidia.com --no-deps "nvidia-modelopt[onnx]>=0.44"

COPY requirements.txt /app/requirements.txt

RUN --mount=type=cache,id=analitico-gpu-pip-cache,target=/root/.cache/pip,sharing=locked \
    python -m pip install -r /app/requirements.txt && \
    python -c "import torch, torchvision; from torchvision.ops import nms; print('torch', torch.__version__, 'cuda', torch.version.cuda, 'torchvision', torchvision.__version__)"

COPY . /app

EXPOSE 8000

CMD ["python3", "main.py"]
