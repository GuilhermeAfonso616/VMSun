# Comece em audit. Troque para recover somente depois de revisar 24-48 horas.
ANALITICO_SUPERVISOR_MODE=audit
ANALITICO_SUPERVISOR_RUNTIME_URL=http://127.0.0.1:8001
ANALITICO_SUPERVISOR_GATEWAY_URL=http://127.0.0.1:8090/healthz
ANALITICO_SUPERVISOR_STATE_DIR=/mnt/analitico_ssd/supervisor
ANALITICO_SUPERVISOR_PROMETHEUS_FILE=/mnt/analitico_ssd/supervisor/analitico_supervisor.prom
ANALITICO_SUPERVISOR_COMPOSE_ENV_FILE=/mnt/analitico_ssd/Analitico_Go_V4/.env.docker

# Deve ser igual a SUPERVISOR_API_TOKEN em .env.docker. Gere um valor aleatorio.
SUPERVISOR_API_TOKEN=

ANALITICO_SUPERVISOR_INTERVAL_SECONDS=10
ANALITICO_SUPERVISOR_TIMEOUT_SECONDS=5
ANALITICO_SUPERVISOR_STALE_SECONDS=90
ANALITICO_SUPERVISOR_FAILURE_THRESHOLD=2
ANALITICO_SUPERVISOR_COOLDOWN_SECONDS=60
ANALITICO_SUPERVISOR_MAX_ACTIONS_PER_HOUR=3
ANALITICO_SUPERVISOR_MAX_BACKOFF_SECONDS=900
ANALITICO_SUPERVISOR_HEALTHY_RESET_CYCLES=6
ANALITICO_SUPERVISOR_QUARANTINE_AFTER_ACTIONS=3
ANALITICO_SUPERVISOR_QUARANTINE_SECONDS=900
ANALITICO_SUPERVISOR_BROAD_FAILURE_RATIO=0.30
ANALITICO_SUPERVISOR_ORPHAN_FAILURE_THRESHOLD=3
ANALITICO_SUPERVISOR_MAX_ORPHAN_CLEANUP_PER_CYCLE=8
ANALITICO_SUPERVISOR_ORPHAN_CLEANUP_COOLDOWN_SECONDS=300
ANALITICO_SUPERVISOR_CIRCUIT_LOG_INTERVAL_SECONDS=300

# Executa uma inferencia sintetica periodica. Fica desligado durante o primeiro audit.
ANALITICO_SUPERVISOR_CANARY_ENABLED=false
ANALITICO_SUPERVISOR_CANARY_INTERVAL_SECONDS=300

# Webhook HTTP opcional. Sem URL, nenhuma notificacao externa e enviada.
ANALITICO_SUPERVISOR_WEBHOOK_URL=
ANALITICO_SUPERVISOR_WEBHOOK_COOLDOWN_SECONDS=300
ANALITICO_SUPERVISOR_INCIDENT_RETENTION_COUNT=20

# E-mail opcional. Deixe SMTP_HOST ou SMTP_TO vazio para manter desativado.
ANALITICO_SUPERVISOR_SMTP_HOST=
ANALITICO_SUPERVISOR_SMTP_PORT=587
ANALITICO_SUPERVISOR_SMTP_USERNAME=
ANALITICO_SUPERVISOR_SMTP_PASSWORD=
ANALITICO_SUPERVISOR_SMTP_FROM=
ANALITICO_SUPERVISOR_SMTP_TO=
ANALITICO_SUPERVISOR_SMTP_STARTTLS=true
ANALITICO_SUPERVISOR_SMTP_SSL=false
ANALITICO_SUPERVISOR_SMTP_COOLDOWN_SECONDS=300

# Reiniciar o container e uma ultima barreira e fica desligado por padrao.
ANALITICO_SUPERVISOR_ALLOW_RUNTIME_RESTART=false
ANALITICO_SUPERVISOR_RUNTIME_RESTART_THRESHOLD=6
ANALITICO_SUPERVISOR_MAX_RUNTIME_RESTARTS_PER_HOUR=2
DOCKER_HOST=unix:///mnt/analitico_ssd/docker-analitico/docker.sock
